<?xml version="1.0" encoding="utf-8"?>
<!-- 全 App 统一的返回按钮：圆形浅底 + 主题色返回箭头 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/ui_chip_bg_focus" />
                    <stroke android:width="2dp" android:color="@color/ui_accent" />
                </shape>
            </item>
            <item android:gravity="center">
                <inset android:inset="13dp" android:drawable="@drawable/ic_back_dark" />
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/ui_chip_bg" />
                    <stroke android:width="1dp" android:color="@color/ui_line" />
                </shape>
            </item>
            <item android:gravity="center">
                <inset android:inset="13dp" android:drawable="@drawable/ic_back_dark" />
            </item>
        </layer-list>
    </item>
</selector>
