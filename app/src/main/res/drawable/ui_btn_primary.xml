<?xml version="1.0" encoding="utf-8"?>
<!-- 主按钮：深蓝实心 + 聚焦描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/ui_btn_press" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="@color/ui_btn" /><corners android:radius="12dp" /><stroke android:width="3dp" android:color="@color/ui_accent" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/ui_btn" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
