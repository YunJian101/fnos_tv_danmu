<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#E01A2431" />
                    <corners android:radius="22dp" />
                    <stroke android:width="2dp" android:color="@color/ui_accent" />
                </shape>
            </item>
            <item android:gravity="center">
                <inset android:inset="18dp" android:drawable="@drawable/ic_forward" />
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#B3131A24" />
                    <corners android:radius="22dp" />
                    <stroke android:width="1dp" android:color="#33FFFFFF" />
                </shape>
            </item>
            <item android:gravity="center">
                <inset android:inset="18dp" android:drawable="@drawable/ic_forward" />
            </item>
        </layer-list>
    </item>
</selector>