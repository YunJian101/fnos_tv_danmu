<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面：所有页面标题都跟随内容滚动，只有「返回 / 搜索 / 设置」是悬浮图标 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:fitsSystemWindows="true">

    <!-- 首页 -->
    <ScrollView
        android:id="@+id/scrollHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/homeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="36dp"
            android:paddingTop="24dp"
            android:paddingRight="36dp"
            android:paddingBottom="36dp" />
    </ScrollView>

    <ImageView
        android:id="@+id/btnSearch"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|right"
        android:layout_marginTop="20dp"
        android:layout_marginRight="104dp"
        android:background="@drawable/ui_chip_circle"
        android:contentDescription="搜索"
        android:elevation="6dp"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ui_icon_search"
        android:tint="@color/ui_text" />

    <ImageView
        android:id="@+id/btnGear"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|right"
        android:layout_marginTop="20dp"
        android:layout_marginRight="40dp"
        android:background="@drawable/ui_chip_circle"
        android:contentDescription="设置"
        android:elevation="6dp"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ui_icon_gear" />

    <!-- 媒体库：标题、搜索、计数、排序全部跟随滚动，只有返回键悬浮 -->
    <FrameLayout
        android:id="@+id/panelLibrary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ui_bg"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
        android:clipChildren="false"
        android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="36dp"
                android:paddingTop="24dp"
                android:paddingRight="36dp"
                android:paddingBottom="36dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="72dp">

                    <TextView
                        android:id="@+id/tvLibTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="媒体库"
                        android:textColor="@color/ui_text"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="280dp"
                        android:layout_height="44dp"
                        android:background="@drawable/ui_input"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:hint="搜索影片、剧集…"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:singleLine="true"
                        android:textColor="@color/ui_text"
                        android:textColorHint="@color/ui_text3"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/libBarRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp" />

                <LinearLayout
                    android:id="@+id/libraryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ImageView
            android:id="@+id/btnLibBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|left"
            android:layout_marginLeft="28dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/ui_back_chip"
            android:contentDescription="返回"
            android:elevation="6dp"
            android:focusable="true" />
    </FrameLayout>

    <!-- 设置 -->
    <FrameLayout
        android:id="@+id/panelSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ui_bg"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
        android:clipChildren="false"
        android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="36dp"
                android:paddingTop="24dp"
                android:paddingRight="36dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="72dp"
                    android:layout_marginBottom="6dp"
                    android:text="设置"
                    android:textColor="@color/ui_text"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/settingsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ImageView
            android:id="@+id/btnSetBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|left"
            android:layout_marginLeft="28dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/ui_back_chip"
            android:contentDescription="返回"
            android:elevation="6dp"
            android:focusable="true" />
    </FrameLayout>
</FrameLayout>
