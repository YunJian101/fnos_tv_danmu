<?xml version="1.0" encoding="utf-8"?>
<!-- 播放器：中央大播放键 + 底部进度与功能胶囊（按预览图），全部自绘 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000" />

    <com.fntv.app.DanmuView
        android:id="@+id/danmuView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/ui_danmu_status"
        android:paddingLeft="18dp"
        android:paddingTop="8dp"
        android:paddingRight="18dp"
        android:paddingBottom="8dp"
        android:text="加载中…"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvSpeedHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginTop="76dp"
        android:layout_marginRight="24dp"
        android:background="@drawable/ui_danmu_status"
        android:paddingLeft="14dp"
        android:paddingTop="6dp"
        android:paddingRight="14dp"
        android:paddingBottom="6dp"
        android:text="倍速播放中"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvDanmuStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_marginLeft="24dp"
        android:layout_marginBottom="150dp"
        android:background="@drawable/ui_danmu_status"
        android:paddingLeft="16dp"
        android:paddingTop="7dp"
        android:paddingRight="16dp"
        android:paddingBottom="7dp"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 顶栏：返回 + 标题 + 弹幕 / 画质 / 更多 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="top"
        android:background="@drawable/ui_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:visibility="invisible">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ui_icon_back"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:ellipsize="end"
            android:maxWidth="520dp"
            android:singleLine="true"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDanmuMatch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text=""
            android:textColor="#FF9AA6B2"
            android:textSize="12sp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnCloudMode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/ui_btn_player"
            android:focusable="true"
            android:minWidth="0dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="直链"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnDanmu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/ui_icon_danmu"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btnLock"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/ui_chip_circle"
            android:contentDescription="锁定"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_unlock" />
    </LinearLayout>

    <!-- 控制层：中央播放键 + 底部进度条与功能胶囊 -->
    <FrameLayout
        android:id="@+id/controller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRewind"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/ui_icon_rewind"
                android:focusable="true" />

            <Button
                android:id="@+id/btnPlayPause"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginLeft="56dp"
                android:layout_marginRight="56dp"
                android:background="@drawable/ui_icon_play_circle"
                android:focusable="true" />

            <Button
                android:id="@+id/btnForward"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/ui_icon_forward"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/ui_scrim_bottom"
            android:orientation="vertical"
            android:paddingLeft="32dp"
            android:paddingTop="46dp"
            android:paddingRight="32dp"
            android:paddingBottom="22dp">

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:max="1000"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:splitTrack="false"
                android:progressDrawable="@drawable/seeker_progress"
                android:thumb="@drawable/seeker_thumb" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="00:00 / 00:00"
                android:textColor="#FFD3DBE6"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/ui_btn_player"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="1.0x"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnRatio"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/ui_btn_player"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="适应"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/ui_btn_player"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="画质"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/ui_btn_player"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="信息"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnEpisodeList"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/ui_btn_player"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="选集"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnNextEp"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/ui_btn_player"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="下一集"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnSkip"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/ui_btn_player"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="跳过片头"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <Button
        android:id="@+id/btnBrightness"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- 信息面板 -->
    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginLeft="40dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/ui_info_card"
        android:minWidth="980dp"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingTop="20dp"
        android:paddingRight="28dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="播放信息"
                android:textColor="#FFF3F6FA"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_btn_player"
                android:focusable="true"
                android:includeFontPadding="false"
                android:paddingLeft="14dp"
                android:paddingTop="6dp"
                android:paddingRight="14dp"
                android:paddingBottom="6dp"
                android:text="关闭"
                android:textColor="#FFDCE6F5"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/infoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="6dp"
            android:text=""
            android:textColor="#FFF2F6FB"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/infoTextAudio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="6dp"
                android:text=""
                android:textColor="#FFDCE6F5"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/infoTextExtra"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_weight="1"
                android:lineSpacingExtra="6dp"
                android:text=""
                android:textColor="#FFDCE6F5"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/trackBtnRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAudioTrack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/ui_btn_player"
                android:focusable="true"
                android:minWidth="0dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="音轨"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSubtitleTrack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/ui_btn_player"
                android:focusable="true"
                android:minWidth="0dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="字幕"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnHdrToggle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/ui_btn_player"
                android:focusable="true"
                android:minWidth="0dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="HDR"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>