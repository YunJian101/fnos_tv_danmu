<?xml version="1.0" encoding="utf-8"?>
<!-- 登录页：左侧品牌，右侧表单卡片（大屏 16:9 布局） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="88dp"
    android:paddingRight="88dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/ui_logo"
            android:gravity="center"
            android:text="FN"
            android:textColor="@color/ui_on_accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="FN TV"
            android:textColor="@color/ui_text"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="6dp"
            android:text="飞牛影视 · 弹幕播放器\n登录你的影视服务，接着上次的地方看。"
            android:textColor="@color/ui_text2"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="v1.4.0 · 适配 Android 13 电视 / 投影仪"
            android:textColor="@color/ui_text3"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loginCard"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:background="@drawable/ui_card"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="登录"
            android:textColor="@color/ui_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="使用飞牛影视的服务器地址与账号"
            android:textColor="@color/ui_text3"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/modeHttp"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/ui_pill"
                android:focusable="true"
                android:gravity="center"
                android:text="服务器登录"
                android:textColor="@color/ui_pill_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/modeFnid"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/ui_pill"
                android:focusable="true"
                android:gravity="center"
                android:text="FN ID 登录"
                android:textColor="@color/ui_pill_text"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/labelHost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="服务器地址"
            android:textColor="@color/ui_text3"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etHost"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/ui_input"
            android:hint="例如 http://192.168.1.1:5666"
            android:imeOptions="actionNext"
            android:inputType="textUri"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:singleLine="true"
            android:textColor="@color/ui_text"
            android:textColorHint="@color/ui_text3"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="用户名"
            android:textColor="@color/ui_text3"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etUser"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/ui_input"
            android:hint="输入用户名"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:singleLine="true"
            android:textColor="@color/ui_text"
            android:textColorHint="@color/ui_text3"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="密码"
            android:textColor="@color/ui_text3"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etPass"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/ui_input"
            android:hint="输入密码"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:singleLine="true"
            android:textColor="@color/ui_text"
            android:textColorHint="@color/ui_text3"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/rememberBox"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/ui_btn_primary"
            android:focusable="true"
            android:gravity="center"
            android:text="登 录"
            android:textColor="@color/ui_on_accent"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_gravity="center_horizontal"
            android:text="登录凭据只保存在本机"
            android:textColor="@color/ui_text3"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
