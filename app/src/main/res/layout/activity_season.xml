<?xml version="1.0" encoding="utf-8"?>
<!-- 季详情页：顶部沿用影片背景图与信息，下面才是本季剧集 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/seasonRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/seasonBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.9"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ui_detail_scrim" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="44dp"
            android:paddingTop="24dp"
            android:paddingRight="44dp"
            android:paddingBottom="40dp">

            <TextView
                android:id="@+id/tvSeriesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="72dp"
                android:text=""
                android:textColor="@color/ui_text2"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvSeasonTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="72dp"
                android:layout_marginTop="4dp"
                android:text="第 1 季"
                android:textColor="@color/ui_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSeasonSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="72dp"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="@color/ui_text3"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvSeasonOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="72dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="18dp"
                android:ellipsize="end"
                android:lineSpacingExtra="4dp"
                android:maxLines="3"
                android:text=""
                android:textColor="@color/ui_text2"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/episodeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
